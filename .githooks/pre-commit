#!/usr/bin/env bash
#
# Chronicle pre-commit hook — runs the test suite before each commit.
# If the tests fail, the commit is aborted.
#
# Enabling (once, after cloning):
#     git config core.hooksPath .githooks
#
set -euo pipefail

# Switch to the project root.
cd "$(git rev-parse --show-toplevel)"

# Prefer the virtual environment's python; fall back to the system python.
if [ -x ".venv/bin/python" ]; then
    PY=".venv/bin/python"
else
    PY="$(command -v python3 || command -v python)"
fi

echo "▶ pre-commit: running tests ($PY) ..."
if ! "$PY" manage.py test scheduler --verbosity=1; then
    echo "✖ Tests failed — commit aborted."
    echo "  (To skip: git commit --no-verify)"
    exit 1
fi
echo "✓ Tests passed — proceeding with the commit."
