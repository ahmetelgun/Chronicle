# ==========================================================================
#  Environment Variables — copy this file to `.env` and fill it in.
#  (the .env file must never be committed to git — it is in .gitignore)
# ==========================================================================

# --- Django ---
DJANGO_SECRET_KEY=change-this-key-to-a-long-and-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Istanbul

# --- LDAP / Active Directory ---
LDAP_SERVER_URI=ldap://ldap.company.local:389
LDAP_BIND_DN=cn=svc_scheduler,ou=service,dc=company,dc=local
LDAP_BIND_PASSWORD=service-account-password
LDAP_USER_SEARCH_BASE=ou=people,dc=company,dc=local
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=company,dc=local

# LDAP group DNs used for RBAC
LDAP_GROUP_ADMIN=cn=sched_admin,ou=groups,dc=company,dc=local
LDAP_GROUP_OPERATOR=cn=sched_operator,ou=groups,dc=company,dc=local
LDAP_GROUP_VIEWER=cn=sched_viewer,ou=groups,dc=company,dc=local

# Set to False to temporarily disable LDAP and work with local Django users
# only (for development convenience).
LDAP_ENABLED=True

# --- Execution Engine ---
# Root directory from which scripts are allowed to run (security restriction).
SCRIPT_ALLOWED_ROOT=/opt/scripts
# Maximum number of jobs that can run concurrently (scheduler thread pool).
SCHEDULER_MAX_WORKERS=10

# Additional Python paths so scripts can import shared modules.
# E.g. if scripts contain `import parameters` and parameters.py lives in another
# directory, add that directory here (multiple separated by ':' or ',').
#   SCRIPT_PYTHONPATH=/opt/shared/lib:/opt/config
SCRIPT_PYTHONPATH=
